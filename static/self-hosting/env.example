# Pocket Nutrition self-hosting settings, read by docker-compose.yml.
# Save this file as .env next to docker-compose.yml, then fill in the empty values.
# Generate each secret with:  openssl rand -hex 32

# Optional parts to run, comma-separated: vault, voice, https
# (the Nutrition API and the Food Dataset always run)
COMPOSE_PROFILES=

# ---------- Nutrition API and Food Dataset (required) ----------

# Password of the main PostgreSQL database.
POSTGRES_PASSWORD=

# Protects POST /admin/reload, which reloads the ingredient catalogue.
RELOAD_TOKEN=

# Model training: fewer trials train faster, more trials predict a little better.
OPTUNA_TRIALS=20

# The ingredient catalogue, downloaded from GitHub at every start. Point it at your fork of
# pocket-nutrition/knowledge to serve your own changes.
DATASET_REPO=pocket-nutrition/knowledge
# Optional: a GitHub token only raises the download rate limit.
GITHUB_TOKEN=

# ---------- Cloud vault (profile "vault") ----------

VAULT_DB_PASSWORD=
# Keeps login challenges stable across restarts.
VAULT_PRELOGIN_SECRET=
# Optional: enables the admin endpoint that creates accounts.
VAULT_ADMIN_TOKEN=
# "open" lets anyone who reaches the server create an account; "closed" stops new sign-ups.
VAULT_REGISTRATION=open
VAULT_SERVER_NAME=Pocket Nutrition Vault

# ---------- Voice and photo (profile "voice") ----------

# The key the apps send; set at least this or a trusted vault.
RECOGNITION_API_KEY=
# Host names of vaults allowed to authenticate users instead of the key (https, public addresses).
RECOGNITION_TRUSTED_VAULTS=

# ---------- HTTPS (profile "https") ----------

# Point each name at this server (DNS) and open ports 80 and 443.
API_DOMAIN=api.localhost
DATASET_DOMAIN=dataset.localhost
VAULT_DOMAIN=vault.localhost
RECOGNITION_DOMAIN=recognition.localhost
